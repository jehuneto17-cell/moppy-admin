rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/admin_whitelist/$(request.auth.uid));
    }

    // KYC: só o próprio dono e admin
    match /kyc/{cleanerId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == cleanerId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == cleanerId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Disputas: participantes do pedido e admin
    match /disputes/{disputeId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
